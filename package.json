{
  "name": "mapit-pro",
  "version": "0.1.0",
  "description": "MapIt Pro desktop app.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win portable",
    "build:mac": "electron-builder --mac dmg zip",
    "license:keygen": "node license/create-keypair.js",
    "license:generate": "node license/generate-license.js",
    "license:admin": "electron license/admin-main.js"
  },
  "build": {
    "appId": "cc.mapit.pro",
    "productName": "MapIt Pro",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "assets/**/*",
      "license/public-key.pem"
    ],
    "icon": "assets/icons/mapitpro.png",
    "win": {
      "icon": "assets/icons/mapitpro.ico",
      "target": [
        "portable"
      ]
    },
    "mac": {
      "icon": "assets/icons/mapitpro.png",
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
